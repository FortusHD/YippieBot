# Application Environment (dev or prod)
APP_ENV=dev

# Discord Bot Credentials - Development
BOT_TOKEN_DEV=your_dev_bot_token_here
BOT_CLIENT_ID_DEV=your_dev_client_id_here

# Discord Bot Credentials - Production
BOT_TOKEN_PROD=your_prod_bot_token_here
BOT_CLIENT_ID_PROD=your_prod_client_id_here

# Database
DB_HOST=localhost
# Must not be "root" (MYSQL_USER of the database container)
DB_USER=yippie_bot
DB_PASSWORD=your_database_password
# Only used by the database container (MYSQL_ROOT_PASSWORD), the bot itself does not need it
DB_ROOT_PASSWORD=your_database_root_password

# API Keys
GOOGLE_KEY=your_google_api_key_here

# Lavalink Configuration (for music functionality)
LAVALINK_HOST=your_lavalink_host
LAVALINK_PORT=2333
LAVALINK_PW=your_lavalink_password
# true = wss/https. Not needed inside a private docker network; required if Lavalink is reachable over the internet
# (then put Lavalink behind a TLS reverse proxy and use its port, e.g. 443)
LAVALINK_SECURE=false

# Health endpoint: interface to listen on (default 127.0.0.1). Use 0.0.0.0 if other containers must reach it.
HTTP_HOST=127.0.0.1

# External Services
GIF_CREATOR=https://your-gif-creator-url.com/create_gif/

# Feature Flags
DEPLOY=false
TEST_WICHTELN=false

# Logging
LOG_LEVEL=DEBUG
ENABLE_ALERT=false